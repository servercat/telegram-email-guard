FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && npm cache clean --force
COPY dist ./dist
COPY server ./server
COPY public ./public
COPY db ./db
COPY tsconfig.json ./
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3001
USER node
HEALTHCHECK --interval=15s --timeout=5s CMD node -e "fetch('http://127.0.0.1:3001/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","--import","tsx","server/index.ts"]
